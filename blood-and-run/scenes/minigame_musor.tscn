[sub_resource type="GDScript" id="GDScript_xbjue"]
resource_name = "mini_game"
script/source = "extends Control

@export var need_colstvo = 3
var teck_colstvo = 0

signal win

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.



# Called every frame. 'delta' is the elapsed time since the previous frame.


func start():
	show()
	for i in need_colstvo-1:
		var node = $Area2D.duplicate()
		node.position = node.position + Vector2(randi_range(-200, 200), randi_range(-200, 200))
		add_child(node)
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	Global.isOnMenu = true

func _on_area_2d_2_area_entered(area: Area2D) -> void:
	teck_colstvo += 1
	area.queue_free()
	if teck_colstvo == need_colstvo:
		win.emit()
		hide()
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
		Global.isOnMenu = false
	pass # Replace with function body.
"

