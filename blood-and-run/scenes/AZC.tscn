[sub_resource type="GDScript" id="GDScript_myhle"]
resource_name = "Prolog"
script/source = "extends Node

var in_cam = false

func _ready():
	pass # Replace with function body.

func _input(event):
	if Input.is_action_just_pressed(\"ui_cut\"):
		if !in_cam:
			start()
		else:
			end()

func start():
			Global.isOnMenu = true
			$Camera3D.current = true
			$Camera3D/Control.show()
			Global.player.get_node(\"/Camera3D/game_ui\").hide()
			in_cam = true
			$AnimationPlayer.play(\"Prolog\")

func _on_animation_player_animation_finished(anim_name):
	end()
	pass # Replace with function body.

func end():
			Global.isOnMenu = false
			$Camera3D.current = false
			$Camera3D/Control.hide()
			Global.player.get_node(\"/Camera3D/game_ui\").show()
			in_cam = false
"

