[sub_resource type="GDScript" id="GDScript_w5m4x"]
resource_name = "liolik"
script/source = "extends Node

#func _input(event):
	#if Input.is_action_just_pressed(\"rush_e\"):
		#tormoz()

func tormoz():
	$No_human/AudioStreamPlayer3D.play()
	$AnimationPlayer.play(\"Тормоз\")


func _on_animation_player_animation_finished(anim_name):
	get_parent().rand = false
	pass # Replace with function body.


func _on_area_3d_body_entered(body):
	if Global.lela:
		tormoz()
		Global.lela = false
	pass # Replace with function body.
"

