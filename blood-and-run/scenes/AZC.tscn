[sub_resource type="GDScript" id="GDScript_173o4"]
resource_name = "Loop"
script/source = "extends StaticBody3D

var flag = true

func _on_area_3d_body_entered(body):
	if body.name == \"Player\":
		body.position = $Marker3D2.position
		if flag:
			Global.achivka(\"Достижение:\\nХа-Ха хорошая попытка!\")
			flag = false
	pass # Replace with function body.


func _on_area_3d_2_body_entered(body):
	if body.name == \"Player\":
		body.position = $Marker3D.position
		if flag:
			Global.achivka(\"Достижение:\\nХа-Ха хорошая попытка!\")
			flag = false
	pass # Replace with function body.
"

