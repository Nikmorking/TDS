[sub_resource type="GDScript" id="GDScript_4nc4p"]
resource_name = "Пульс"
script/source = "@tool
extends TextureRect

@export_category(\"Параметры пульсации\")
## Скорость/частота сердцебиения (чем выше, тем быстрее пульс)
@export var pulse_speed: float = 4.0
## Глубина/интенсивность пульсации (насколько сильно меняется размер и альфа)
@export var pulse_depth: float = 0.05
## Базовая прозрачность (насколько вены видны изначально, от 0.0 до 1.0)
@export var base_alpha: float = 0.5

var time_passed: float = 0.0
var original_scale: Vector2

func _ready() -> void:
	original_scale = scale
	# Центрируем опорную точку, чтобы пульсировало из центра экрана
	pivot_offset = size / 2.0
	item_rect_changed.connect(func(): pivot_offset = size / 2.0)


func _process(delta: float) -> void:
	if Engine.is_editor_hint():
		queue_redraw()
		
	if base_alpha <= 0.0:
		modulate.a = 0.0
		scale = original_scale
		return

	time_passed += delta * pulse_speed
	
	# Мягкая синусоида от 0.0 до 1.0
	var wave = sin(time_passed) * 0.5 + 0.5
	
	# ТЕПЕРЬ ВЫЧИТАЕМ: альфа падает ОТ base_alpha вниз и возвращается обратно
	modulate.a = clamp(base_alpha - (wave * pulse_depth), 0.0, 1.0)
	
	# Для размера можно оставить увеличение, либо тоже сделать уменьшение (по вкусу)
	# Если хотите, чтобы размер тоже уменьшался синхронно с прозрачностью:
	var scale_factor = -wave * pulse_depth 
	scale = original_scale + Vector2(scale_factor, scale_factor)
"

