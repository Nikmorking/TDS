[sub_resource type="VisualShaderNodeGlobalExpression" id="VisualShaderNodeGlobalExpression_xfj74"]
size = Vector2(680, 480)
expression = "bool lid(vec2 p, float k, float w) {
    float line_y = k * p.x;
    return (p.y < line_y + w) && (p.y > line_y - w);
}
bool par(float pos, float kof){
return pos < kof && pos > kof*-1.0;
}
bool to(float kof, vec2 i){
return lid(i, 1.0, kof*1.5) 
|| lid(i, -1.0, kof*1.5) 
|| par(i.y, kof)
|| par(i.x, kof);
}
// Функция возвращает true, если точка попадает на один из лучей
bool sunburst(vec2 p, float count, float thickness) {
    // 1. Находим угол точки в радианах
    float angle = atan(p.y, p.x); 
    
    // 2. Делаем синусоидальную волну по кругу
    // sin() будет плавно переключаться между -1 и 1
    float pattern = sin(angle * count); 
    
    // 3. Превращаем плавную волну в четкую линию (маску)
    // thickness задает ширину полос (значения от 0.0 до 1.0)
    return pattern > (1.0 - thickness); 
}"

