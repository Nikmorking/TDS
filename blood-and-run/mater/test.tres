    //}
	// 1. Искажаем дистанцию, добавляя вторую синусоиду (создает случайную ширину полос)
float distorted_dist = dist + sin(dist * chasto * 0.35) * 0.4;

// 2. Базовая волна
float wave = sin(distorted_dist * chasto);

// 3. Добавляем быстрый 1D псевдо-шум для резких случайных сдвигов толщины
float noise = fract(sin(floor(distorted_dist * chasto)) * 43758.5453);
wave += (noise - 0.5) * 0.6; // накладываем шум на волну

// 4. Регулируем баланс фиолетового и черного:
