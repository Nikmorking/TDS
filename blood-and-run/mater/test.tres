[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_omh1f"]
size = Vector2(1040, 860)
expression = "float k = 1.0;
float b = -0.1;
float d = dot(i, i); // Эквивалентно i.x * i.x + i.y * i.y
float dist = length(i);

if (d > r) {
    ou = mix(c1,vec3(0.0,0.0,0.0),0.97);
}
else {
	//bool u = to(0.04, i);
	//bool u = sunburst(i, 100.0,0.2);
    //if (u) {
		//ou = mix(c2, vec3(6.0, 6.0, 6.0), sin(dist));
        //if (j){ou = vec3(0.0, 0.0, 0.0);}
		//else{ou = vec3(1.0, 0.0, 0.0);}
    //}
	//else {
	//float falloff = clamp(1.0 - (dist), 0.0, 1.0);
	//falloff = pow(falloff, 2.0); // Делает спад более плавным
        //float s = (sin((dist+1.0) * chasto)+1.0)/2.0;
		//s = pow(s, 4.0);
        //ou = falloff*mix(mix( mix(c2,vec3(0.0,0.0,0.0),0.6),mix(c2,vec3(1.0,0.0,1.0),0.7), s), vec3(0.0,0.0,0.0), 0.9);
    //}
	// 1. Искажаем дистанцию, добавляя вторую синусоиду (создает случайную ширину полос)
float distorted_dist = dist + sin(dist * chasto * 0.35) * 0.4;

// 2. Базовая волна
float wave = sin(distorted_dist * chasto);

// 3. Добавляем быстрый 1D псевдо-шум для резких случайных сдвигов толщины
float noise = fract(sin(floor(distorted_dist * chasto)) * 43758.5453);
wave += (noise - 0.5) * 0.6; // накладываем шум на волну

// 4. Регулируем баланс фиолетового и черного:
// Переводим wave из диапазона [-1, 1] в [0, 1]
float pattern = (wave + 1.0) * 0.5;

// С помощью smoothstep делаем фиолетовые полосы широкими, 
// а черные прослойки — узкими и четкими
float mask = smoothstep(0.15, 0.4, pattern); 

// 5. Цвет и плавное затухание к краям
vec3 bright_purple = mix(vec3(0.7, 0.1, 1.0), c2, 0.1); // Яркий неоновый фиолетовый
vec3 dark_purple   = mix(vec3(0.1, 0.0, 0.15), c2, 0.1); // Тёмно-фиолетовый вместо чисто черного

float falloff = clamp(1.0 - (dist), 0.0, 1.0);
falloff = pow(falloff, 1.5);

// Смешиваем тёмный фиолетовый и яркий неоновый
vec3 final_color = mix(dark_purple, bright_purple * 2.0, mask);

ou = final_color * falloff;
}"

