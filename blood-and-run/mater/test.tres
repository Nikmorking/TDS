float falloff = clamp(1.0 - (dist), 0.0, 1.0);
falloff = pow(falloff, 1.5);

// Смешиваем тёмный фиолетовый и яркий неоновый
vec3 final_color = mix(dark_purple, bright_purple * 2.0, mask);

ou = final_color * falloff;
}"
