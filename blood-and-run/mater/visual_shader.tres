[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_hrxub"]
parameter_name = "Razmer"
default_value_enabled = true
default_value = 0.5

[sub_resource type="VisualShaderNodeTexture" id="VisualShaderNodeTexture_sg301"]
texture = ExtResource("1_olj0s")
texture_type = 1

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_r6imp"]
size = Vector2(1200, 1200)
expression = "if (dot(st, st) < r)
{
float dist = length(st);

    // 2. Искажаем дистанцию
    float distorted_dist = dist + sin(dist * frequency * 0.3) * (randomness * 0.05);

    // 3. Косинус для фиолетового центра
    float wave = cos(distorted_dist * frequency);

    // 4. Формируем кольца
	float ring_id = floor(distorted_dist * frequency);

    // 3. Рандомное число от 0.0 до 1.0 для КАЖДОГО кольца индивидуально
    float ring_random_thickness = fract(sin(ring_id * 12.9898) * 43758.5453);
    float rings = abs(wave);
    rings = pow(rings, razmer); // Регулирует ширину тёмных полос




float local_razmer = mix(razmer * 0.3, razmer * 2.0, ring_random_thickness);
    rings = pow(rings, local_razmer);

    // 6. Двойное затухание: внутреннее для колец и широкое мягкое для ореола (Halo)
    float ring_falloff = smoothstep(r, r * 0.2, dist);
    float ambient_falloff = smoothstep(r * 1.6, 0.0, dist) * 0.4;

    // 7. Формируем паттерн и смешиваем с фоновой текстурой c3
    vec3 spot_pattern = mix(c1, c2, rings);
    vec3 final_spot = mix(c1 * 0.4, spot_pattern, ring_falloff);

    alb = mix(c3, final_spot, max(ring_falloff, ambient_falloff));

EMISSION = c2 * rings * ring_falloff * 1.5;
}
else{alb = c3;}"

