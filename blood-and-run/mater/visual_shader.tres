[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_n84b6"]
parameter_name = "Radius"

[sub_resource type="VisualShaderNodeMix" id="VisualShaderNodeMix_n84b6"]
output_port_for_preview = 0
