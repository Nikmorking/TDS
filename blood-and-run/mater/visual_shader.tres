[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_hrxub"]
size = Vector2(1020, 660)
expression = "    vec2 st = ver.xy;    vec2 st = VERTEX.xy;
    float dist = length(st);
    
    // 2. Искажаем дистанцию
    float distorted_dist = dist + sin(dist * frequency * 0.3) * (randomness * 0.05);

    // 3. Используем COSINE: cos(0) = 1.0, поэтому в самом центре всегда фиолетовое пятно!
    float wave = cos(distorted_dist * frequency);

    // 4. Формируем кольца
    float rings = abs(wave);
    rings = pow(rings, 0.35); // Регулирует ширину тёмных полос

    // 5. Мягкая маска круга
    float falloff = clamp(1.0 - dist, 0.0, 1.0);
    falloff = smoothstep(0.0, 1.0, falloff);

    // 6. Смешиваем цвета
    vec3 final_rgb = mix(line_color.rgb, spot_color.rgb, rings);

    ALBEDO = final_rgb;
    ALPHA = falloff * spot_color.a;
    float dist = length(st);
    
    // 2. Искажаем дистанцию
    float distorted_dist = dist + sin(dist * frequency * 0.3) * (randomness * 0.05);

    // 3. Используем COSINE: cos(0) = 1.0, поэтому в самом центре всегда фиолетовое пятно!
    float wave = cos(distorted_dist * frequency);

    // 4. Формируем кольца
    float rings = abs(wave);
    rings = pow(rings, 0.35); // Регулирует ширину тёмных полос

    // 5. Мягкая маска круга
    float falloff = clamp(1.0 - (dist / radius), 0.0, 1.0);
    falloff = smoothstep(0.0, 1.0, falloff);

    // 6. Смешиваем цвета
    vec3 final_rgb = mix(line_color.rgb, spot_color.rgb, rings);

    ALBEDO = final_rgb;
    ALPHA = falloff * spot_color.a;"

