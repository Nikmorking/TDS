[sub_resource type="GDScript" id="GDScript_3dp1s"]
resource_name = "Ekran"
script/source = "extends Control

@onready var labels = $VBoxContainer.get_children()
@onready var checks = $Control.get_children()
# Called when the node enters the scene tree for the first time.
func _ready():
	pass # Replace with function body.

func vis(zakaz):
	for i in checks:
		i.button_pressed = false
	for i in zakaz.size():
		checks[i].show()
		if zakaz[i] == \"ahabka_buttonov\": 
			labels[i].text.text = \"Hleb\"
		else:
			labels[i].text = zakaz[i]


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	pass
"

