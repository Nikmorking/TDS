[sub_resource type="GDScript" id="GDScript_dlnaw"]
resource_name = "ekran"
script/source = "extends MeshInstance3D

@onready var shad: ShaderMaterial = material_override.next_pass
var run = false

func _ready():
	Global.connect(\"bad\", change_red)

func change_red():
	if run:
		change_color(Vector4(0.5, 0.5, 0.5, 1.0))
		shad.set_shader_parameter(\"line_thickness\", 0.2)
	else:
		change_color(Vector4(0.9, 0.0, 0.0, 1.0))
		shad.set_shader_parameter(\"line_thickness\", 0.5)
	run = !run

func change_color(color: Vector4):
	shad.set_shader_parameter(\"line_color\", color)
"

