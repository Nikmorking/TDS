		if str(Global.get_papa(4, self).name) != str(list[0]):
			multiplayer.multiplayer_peer.disconnect_peer(list[0])
			queue_free()
		else:
			print(\"ты дебил !?\")
	else:
		print(\"недостаток прав\")
	pass # Replace with function body.
