[sub_resource type="GDScript" id="GDScript_2c4u5"]
resource_name = "Main menu"
script/source = "extends Menu


# Called when the node enters the scene tree for the first time.
func _ready():
	
	if FileAccess.file_exists(\"user://savegame.save\"):
		var save_file = FileAccess.open(\"user://savegame.save\", FileAccess.READ)
		if save_file.get_length() > 0:
			$Cont.show()
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	pass


func _on_обучение_button_down():
	get_tree().change_scene_to_file(\"res://scenes/main.tscn\")
	pass # Replace with function body.


func _on_start_button_down():
	Global.igra = true
	get_tree().change_scene_to_file(\"res://scenes/AZC.tscn\")
	pass # Replace with function body.


func _on_cont_button_down():
	Global.is_load = true
	Global.igra = true
	get_tree().change_scene_to_file(\"res://scenes/AZC.tscn\")
	pass # Replace with function body.


func _on_quit__button_down():
	get_tree().quit()
	pass # Replace with function body.
"

